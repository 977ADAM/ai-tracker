# Copy to `.env` next to docker-compose.yml; compose reads it automatically.
# Every value is optional: a key or an address saved in the settings screen wins
# over the environment, so this file is only needed for a fresh deployment or for
# keys you would rather not keep in the data volume.

# Where the interface is opened from. adapter-node checks the Origin of
# state-changing requests against it: change it when the interface is not on
# http://localhost:3000 (for example http://192.168.1.10:3000).
AI_TRACKER_ORIGIN=http://localhost:3000

# Yandex Search API (the SEO analysis searches the Yandex index).
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=

# The service LLM that leads the SEO agents. It must support tool calling.
SEO_LLM_ENDPOINT=
SEO_LLM_MODEL=
SEO_LLM_API_KEY=

# Keys of the model connections the SEO analysis checks. They are the fallback
# for connections whose id is the built-in `gigachat` or `deepseek`; a connection
# created in the settings screen keeps its key in the data volume instead, and
# that is the usual way to add one.
GIGACHAT_AUTH_KEY=
DEEPSEEK_API_KEY=
