    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^27.0.0",
